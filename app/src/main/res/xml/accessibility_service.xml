<?xml version="1.0" encoding="utf-8"?>
<!-- Key filtering and window events are switched on at run time only while a prompter session runs over another app
     (PrompterAccessibilityService.onSessionChanged); onServiceConnected turns the event type below off right after
     binding, and events outside a session are ignored anyway. Screen content is never read. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="200" />
